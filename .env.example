# Used by the CLI (cli/bin/cli.js) when run from the repo root.
# For the backend/frontend, use backend/.env and frontend/.env instead.

# --- Free setup (default) ---
# Get a free key (no credit card) at https://console.groq.com/keys
LLM_PROVIDER=groq
GROQ_API_KEY=gsk-your-free-groq-key-here
GROQ_MODEL=openai/gpt-oss-120b

# --- Paid alternative (optional) ---
# To use Claude instead, set LLM_PROVIDER=anthropic and fill these in:
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# CLAUDE_MODEL=claude-sonnet-5
